# --- Stack settings (used by docker-compose.yml) ---
GATEWAY_VERSION=0.1.0
# Absolute folder of this stack; workspaces live in $GATEWAY_DIR/workspaces (same path on host and in the container).
GATEWAY_DIR=/srv/deploy-gateway
# Dedicated registry credentials for agent pulls (inline `auths`, no credsStore), e.g. created with
#   DOCKER_CONFIG=/srv/deploy-gateway/registry docker login ghcr.io
# Every workspace can pull any image these credentials can read: use least-privilege pull tokens only.
DOCKER_CONFIG_FILE=/srv/deploy-gateway/registry/config.json
# Public hostnames for the agent endpoint and the admin UI.
MCP_HOST=mcp.example.com
ADMIN_HOST=deploy-admin.example.com
# External Docker network your reverse proxy is attached to, and its HTTPS entrypoint.
PROXY_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
# Memory limit of the gateway container itself.
#GATEWAY_MEM_LIMIT=512m
# How long Docker waits for the gateway to finish running deploys on stop (above DEPLOY_TIMEOUT + 30s).
#GATEWAY_STOP_GRACE=6m

# --- Gateway settings ---
# Admin login. Generate with:  docker run --rm -i ghcr.io/sebbi08/deployment-gateway:0.1.0 hash-password
# Keep the single quotes: the hash contains $ characters that compose would otherwise interpolate.
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$REPLACE$REPLACE'

# Alternative (proxy mode): leave ADMIN_PASSWORD_HASH empty and rely on a forward-auth proxy only.
# Both of the following are then required, otherwise the gateway refuses to start.
# Proxy mode also REQUIRES the forward-auth middleware on the admin router (see docker-compose.yml), and it must
# set or overwrite ADMIN_USER_HEADER (Traefik: authResponseHeaders) - otherwise any client can send the header.
# ADMIN_TRUSTED_PROXIES must be the reverse proxy's pinned single IP (ipv4_address), not the subnet of a shared
# network: every container with an address in it could claim an admin identity.
#ADMIN_TRUSTED_PROXIES=<reverse-proxy IP>
#ADMIN_USER_HEADER=Remote-User

# Reverse proxy address(es) whose X-Forwarded-For is trusted for audit/rate limiting
# (agent API and admin login).
# Set this when the gateway runs behind a proxy (IP of your proxy container, ideally pinned, e.g. 172.20.0.10);
# otherwise every agent shares the proxy's address and the gateway warns at startup.
TRUSTED_PROXIES=

# Numeric uid:gid whose GROUP gets read access to the workspace/app folders and generated compose files
# (e.g. your host user's group). They stay owned by root: the gateway runs them as root.
# Service data folders (data/<service>) keep the owner the container runs as.
#FILE_OWNER=1000:1000

# Hardened container runtimes allowed besides runc, e.g. runsc (gVisor) when it is the daemon default.
#EXTRA_RUNTIMES=

#DEPLOY_TIMEOUT=300s
#DEPLOY_CONCURRENCY=1

# Only needed if you set a custom `hostname:` on the gateway container: name or ID of its own container
# (used by the startup mount check).
#SELF_CONTAINER_ID=deploy-gateway
